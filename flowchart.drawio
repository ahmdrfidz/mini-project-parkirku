<diagram id="page4" name="Tahap 3 - Hitung Biaya">
<mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="995" pageHeight="1174" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="tah1" value="Mulai Tahap 3 (data sudah valid)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="10" width="260" height="40" as="geometry"/></mxCell>
<mxCell id="tah2" value="durasi = total_menit_keluar − total_menit_masuk&lt;br&gt;jam_tagih = (durasi + 59) // 60" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="210" y="84" width="340" height="54" as="geometry"/></mxCell>
<mxCell id="tah3" value="jenis == &quot;motor&quot;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="172" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="tah4" value="tarif_pertama = 2000&lt;br&gt;tarif_berikutnya = 1000&lt;br&gt;tarif_maks = 8000" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="177" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="tah5" value="tarif_pertama = 4000&lt;br&gt;tarif_berikutnya = 2000&lt;br&gt;tarif_maks = 16000" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="177" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="tah6" value="durasi ≤ BATAS_GRATIS&lt;br&gt;(15 menit)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="265" y="292" width="230" height="90" as="geometry"/></mxCell>
<mxCell id="tah7" value="tarif_dasar = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="765" y="315" width="170" height="44" as="geometry"/></mxCell>
<mxCell id="tah8" value="tarif_dasar = tarif_pertama +&lt;br&gt;(jam_tagih − 1) × tarif_berikutnya" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="416" width="320" height="54" as="geometry"/></mxCell>
<mxCell id="tah9" value="tarif_dasar &amp;gt;&lt;br&gt;tarif_maks?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="504" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="tah10" value="tarif_dasar = tarif_maks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="522" width="200" height="44" as="geometry"/></mxCell>
<mxCell id="tah11" value="punya_kartu DAN&lt;br&gt;NOT tiket_hilang DAN&lt;br&gt;tarif_dasar &amp;gt; 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="255" y="630" width="250" height="110" as="geometry"/></mxCell>
<mxCell id="tah12" value="diskon = tarif_dasar × 20 // 100" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="565" y="663" width="230" height="44" as="geometry"/></mxCell>
<mxCell id="tah13" value="diskon = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-35" y="663" width="230" height="44" as="geometry"/></mxCell>
<mxCell id="tah14" value="tiket_hilang?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="786" width="180" height="74" as="geometry"/></mxCell>
<mxCell id="tah15" value="denda = 10000" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="565" y="801" width="170" height="44" as="geometry"/></mxCell>
<mxCell id="tah16" value="denda = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="25" y="801" width="170" height="44" as="geometry"/></mxCell>
<mxCell id="tah17" value="total = tarif_dasar − diskon + denda" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="906" width="300" height="44" as="geometry"/></mxCell>
